SET documentdb.next_collection_id TO 91000400;
SET documentdb.next_collection_index_id TO 91000400;
SET documentdb_core.bsonUseEJson TO on;
SET documentdb.alternate_index_handler_name = 'btree';
SET documentdb.enableAddShardKeyOnlyOnPrimaryKeyFilters = on;
SET documentdb.enableExplainScanIndexCosts = off;
SET client_min_messages = warning;
\set VERBOSITY terse
DO $$
BEGIN
    PERFORM documentdb_api_internal.create_indexes_non_concurrently(
        'btree_find_sort_db',
        $cmd${"createIndexes":"ordered","indexes":[
            {"key":{"a":1},"name":"a_1"},
            {"key":{"b":1},"name":"b_1"},
            {"key":{"a":1,"b":1},"name":"a_b"}
        ]}$cmd$);
    PERFORM documentdb_api.insert_one(
        'btree_find_sort_db', 'ordered',
        format('{"_id":%s,"a":%s,"b":%s}', i, i % 4, 25 - i)::documentdb_core.bson)
    FROM generate_series(1, 24) AS inputs(i);
END;
$$;
SELECT 'documentdb_data.documents_' || collection_id AS table_name
FROM documentdb_api_catalog.collections
WHERE database_name = 'btree_find_sort_db' AND collection_name = 'ordered'
\gset
\d :table_name
               Table "documentdb_data.documents_91000401"
     Column      |         Type         | Collation | Nullable | Default 
-----------------+----------------------+-----------+----------+---------
 shard_key_value | bigint               |           | not null | 
 object_id       | documentdb_core.bson |           | not null | 
 document        | documentdb_core.bson |           | not null | 
Indexes:
    "collection_pk_91000401" PRIMARY KEY, btree (shard_key_value, object_id)
    "documents_rum_index_91000402" btree (documentdb_btree_catalog.bson_btree_extract_path(document, 'a'::text, NULL::text) documentdb_btree_catalog.bson_btree_single_path_ops)
    "documents_rum_index_91000403" btree (documentdb_btree_catalog.bson_btree_extract_path(document, 'b'::text, NULL::text) documentdb_btree_catalog.bson_btree_single_path_ops)
    "documents_rum_index_91000404" btree (documentdb_btree_catalog.bson_btree_extract_path(document, 'a'::text, NULL::text) documentdb_btree_catalog.bson_btree_single_path_ops, documentdb_btree_catalog.bson_btree_extract_path(document, 'b'::text, NULL::text) documentdb_btree_catalog.bson_btree_single_path_ops)
Check constraints:
    "shard_key_value_check" CHECK (shard_key_value = '91000401'::bigint)

ANALYZE :table_name;
SET enable_seqscan = off;
SET enable_bitmapscan = off;
