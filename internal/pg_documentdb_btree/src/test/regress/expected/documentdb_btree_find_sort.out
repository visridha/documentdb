-- A full index scan must retain missing/null paths and both BSON type extrema.
DO $$
BEGIN
    PERFORM documentdb_api_internal.create_indexes_non_concurrently(
        'btree_find_sort_db',
        '{"createIndexes":"full_scan_values","indexes":[{"key":{"a":1},"name":"a_1"}]}');
    PERFORM documentdb_api.insert_one(
        'btree_find_sort_db', 'full_scan_values', value::documentdb_core.bson)
    FROM (VALUES
        ('{"_id":1,"a":{"$minKey":1}}'),
        ('{"_id":2,"a":null}'),
        ('{"_id":3}'),
        ('{"_id":4,"a":-5}'),
        ('{"_id":5,"a":"z"}'),
        ('{"_id":6,"a":{"$maxKey":1}}')
    ) AS inputs(value);
END;
$$;
EXPLAIN (COSTS OFF, ANALYZE ON, SUMMARY OFF, TIMING OFF, BUFFERS OFF)
SELECT document FROM documentdb_api_catalog.bson_aggregation_find(
    'btree_find_sort_db', '{"find":"full_scan_values","sort":{"a":1,"_id":1},"hint":"a_1"}');
                                                                                                                         QUERY PLAN                                                                                                                         
------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Incremental Sort (actual rows=6 loops=1)
   Sort Key: (documentdb_api_catalog.bson_orderby(document, '{ "a" : { "$numberInt" : "1" } }'::documentdb_core.bson)) NULLS FIRST, (documentdb_api_catalog.bson_orderby(document, '{ "_id" : { "$numberInt" : "1" } }'::documentdb_core.bson)) NULLS FIRST
   Presorted Key: (documentdb_api_catalog.bson_orderby(document, '{ "a" : { "$numberInt" : "1" } }'::documentdb_core.bson))
   Full-sort Groups: 1  Sort Method: quicksort  Average Memory: 25kB  Peak Memory: 25kB
   ->  Custom Scan (DocumentDBApiExplainQueryScan) (actual rows=6 loops=1)
         namespaceName: btree_find_sort_db.full_scan_values
