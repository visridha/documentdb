SET documentdb.next_collection_id TO 91000300;
SET documentdb.next_collection_index_id TO 91000300;
SET documentdb_core.bsonUseEJson TO on;
SET documentdb.alternate_index_handler_name = 'btree';
SET client_min_messages = warning;
\set VERBOSITY terse
DO $$
BEGIN
    PERFORM documentdb_api_internal.create_indexes_non_concurrently(
        'btree_planner_db',
        $cmd${"createIndexes":"choices","indexes":[
            {"key":{"a":1},"name":"a_1"},
            {"key":{"b":1},"name":"b_1"},
            {"key":{"c":1},"name":"c_1"},
            {"key":{"a":1,"b":1},"name":"a_b"}
        ]}$cmd$);
    PERFORM documentdb_api.insert_one(
        'btree_planner_db', 'choices',
        format('{"_id":%s,"a":%s,"b":%s,"c":%s,"padding":"%s"}',
               i, i % 10, i, (i / 10) % 10, repeat('x', 300))::documentdb_core.bson)
    FROM generate_series(1, 1000) AS inputs(i);
END;
$$;
SELECT 'documentdb_data.documents_' || collection_id AS table_name
FROM documentdb_api_catalog.collections
WHERE database_name = 'btree_planner_db' AND collection_name = 'choices'
\gset
\d :table_name
               Table "documentdb_data.documents_91000301"
     Column      |         Type         | Collation | Nullable | Default 
-----------------+----------------------+-----------+----------+---------
 shard_key_value | bigint               |           | not null | 
 object_id       | documentdb_core.bson |           | not null | 
 document        | documentdb_core.bson |           | not null | 
Indexes:
    "collection_pk_91000301" PRIMARY KEY, btree (shard_key_value, object_id)
    "documents_rum_index_91000302" btree (documentdb_btree_catalog.bson_btree_extract_path(document, 'a'::text, NULL::text) documentdb_btree_catalog.bson_btree_single_path_ops)
    "documents_rum_index_91000303" btree (documentdb_btree_catalog.bson_btree_extract_path(document, 'b'::text, NULL::text) documentdb_btree_catalog.bson_btree_single_path_ops)
    "documents_rum_index_91000304" btree (documentdb_btree_catalog.bson_btree_extract_path(document, 'c'::text, NULL::text) documentdb_btree_catalog.bson_btree_single_path_ops)
    "documents_rum_index_91000305" btree (documentdb_btree_catalog.bson_btree_extract_path(document, 'a'::text, NULL::text) documentdb_btree_catalog.bson_btree_single_path_ops, documentdb_btree_catalog.bson_btree_extract_path(document, 'b'::text, NULL::text) documentdb_btree_catalog.bson_btree_single_path_ops)
Check constraints:
    "shard_key_value_check" CHECK (shard_key_value = '91000301'::bigint)

ANALYZE :table_name;
SELECT index_relation.relname, stats.staattnum, stats.stadistinct
FROM pg_index AS indexes
JOIN pg_class AS index_relation ON index_relation.oid = indexes.indexrelid
JOIN pg_statistic AS stats ON stats.starelid = indexes.indexrelid
WHERE indexes.indrelid = :'table_name'::regclass
ORDER BY index_relation.relname, stats.staattnum;
 relname | staattnum | stadistinct 
---------+-----------+-------------
(0 rows)

